recursive-include configs *.json
recursive-include docs *.md *.json *.svg *.csv
recursive-include examples *.py *.json *.md
recursive-include legacy *.py *.md *.yaml
recursive-include scripts *.py
recursive-include tests *.py *.json
recursive-include deploy Dockerfile .dockerignore *.md *.py
recursive-include docs/report/figures *.pdf
include docs/report/figures/source_frame.jpg
include docs/report/figures/starbucks.jpg
include docs/report/figures/substation_navigation.jpg
include docs/report/figures/substation_press.jpg
include docs/report/figures/new_video_survey_frame.png
include docs/report/figures/starbucks_semantic_overlay.png
include docs/report/figures/substation_semantic_overlay.png
include THIRD_PARTY_NOTICES.md
exclude docs/report/main.tex docs/report/main.pdf
recursive-exclude docs/report *.aux *.toc *.out *.log *.fls *.fdb_latexmk *.synctex.gz
