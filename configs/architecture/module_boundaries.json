{
  "schema_version": 1,
  "package": "simready",
  "source_directory": "src/simready",
  "dynamic_import_routers": {
    "cli.py": "Top-level COMMANDS allowlist; only dispatches domains",
    "simulation/cli.py": "WORKERS allowlist; only dispatches simulation workers",
    "workflows/cli.py": "Registered core workflow commands only"
  },
  "forbidden_runtime_roots": [
    "legacy",
    "tests",
    "examples",
    "simready_bridge"
  ],
  "forbidden_module_names": [
    "runner",
    "scheduler",
    "utils",
    "helpers",
    "common",
    "manager"
  ],
  "domains": {
    "core": {
      "responsibility": "File evidence, JSON IO, primitive validation and boundary types",
      "allowed_dependencies": []
    },
    "geometry": {
      "responsibility": "Coordinate conventions, transform validation and pure projection geometry",
      "allowed_dependencies": []
    },
    "execution": {
      "responsibility": "Task graphs, resource leases, processes and artifact cache",
      "allowed_dependencies": [
        "core"
      ],
      "layers": {
        ".": [
          "resources",
          "processes",
          "workers",
          "tasks"
        ],
        "resources": [],
        "processes": [
          "resources"
        ],
        "workers": [
          "resources",
          "processes"
        ],
        "tasks": [
          "resources",
          "processes"
        ]
      },
      "root_modules": [
        "__init__",
        "__main__",
        "cli"
      ]
    },
    "ingestion": {
      "responsibility": "Extract video observations and produce source-bound semantic masks",
      "allowed_dependencies": [
        "core",
        "execution",
        "geometry",
        "assets"
      ],
      "layers": {
        ".": [
          "reconstruction",
          "segmentation"
        ],
        "reconstruction": [],
        "segmentation": []
      },
      "root_modules": [
        "__init__",
        "__main__",
        "cli",
        "nerf2physics",
        "video_frames"
      ]
    },
    "evaluation": {
      "responsibility": "Observe, score and independently verify scene candidates",
      "allowed_dependencies": [
        "core",
        "execution"
      ],
      "layers": {
        ".": [
          "inspection"
        ],
        "inspection": []
      },
      "root_modules": [
        "__init__",
        "__main__",
        "asset_graph",
        "cli",
        "nerf2physics",
        "observations",
        "protocol",
        "scoring",
        "verification"
      ]
    },
    "workflows": {
      "responsibility": "Coordinate video reconstruction, asset compilation, validation and baseline comparison",
      "allowed_dependencies": [
        "core",
        "execution",
        "evaluation",
        "ingestion",
        "simulation",
        "assets"
      ],
      "layers": {
        ".": [
          "pipelines"
        ],
        "contracts": [],
        "stages": [
          "contracts"
        ],
        "planning": [
          "contracts",
          "stages"
        ],
        "pipelines": [
          "contracts",
          "stages",
          "planning"
        ]
      },
      "root_modules": [
        "__init__",
        "__main__",
        "cli"
      ]
    },
    "simulation": {
      "responsibility": "Generic Isaac Sim environment, calibrated observation, physical probes and survey rendering",
      "allowed_dependencies": [
        "core",
        "geometry",
        "execution",
        "assets"
      ]
    },
    "assets": {
      "responsibility": "Portable appearance, evidence association, physical declarations and CPU scene compilation",
      "allowed_dependencies": [
        "core",
        "geometry"
      ],
      "layers": {
        ".": [
          "appearance",
          "physics",
          "association",
          "compilation"
        ],
        "appearance": [],
        "physics": [],
        "association": [
          "appearance",
          "physics"
        ],
        "compilation": [
          "appearance",
          "physics"
        ]
      },
      "root_modules": [
        "__init__"
      ]
    }
  },
  "public_functions": [
    "simready.execution.tasks.graph.run_task_graph",
    "simready.evaluation.scoring.evaluate_candidate",
    "simready.evaluation.verification.verify_candidate",
    "simready.ingestion.video_frames.extract_frames",
    "simready.ingestion.segmentation.grounded.grounded_segment_image",
    "simready.ingestion.segmentation.semantic.segment_image",
    "simready.assets.association.semantic_projection.build_semantic_spec",
    "simready.geometry.depth_projection.backproject_depth",
    "simready.assets.physics.physical_spec.normalize_physics",
    "simready.simulation.camera_calibration.rendered_camera_calibration",
    "simready.evaluation.inspection.physical_assets.inspect_physical_assets",
    "simready.evaluation.inspection.physical_receipt.verify_physical_receipt",
    "simready.workflows.pipelines.semantic_assets.run_semantic_assets",
    "simready.assets.physics.physical_candidate.compile_candidate",
    "simready.assets.compilation.scene_preparation.prepare_scene"
  ]
}
